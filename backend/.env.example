# ResQLink Tactical Core Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (Atlas or Local Mongo)
MONGODB_URI=mongodb://127.0.0.1:27017/resqlink

# Security & Authentication
JWT_SECRET=resqlink-tactical-secret-key-2026-field-ready
JWT_EXPIRES_IN=7d
FIREBASE_PROJECT_ID=resqlink-prod

# Tactical Telemetry & Pager Heartbeat Timeouts (in ms)
PAGER_HEARTBEAT_TIMEOUT_MS=90000
DEADMAN_MOTION_TIMEOUT_MS=180000

# CORS
CORS_ORIGIN=*

